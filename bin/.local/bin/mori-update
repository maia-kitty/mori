#!/usr/bin/env python3
"""Interactive updates across Linux package managers; Python 3.9+, no dependencies."""

import argparse
import contextlib
from dataclasses import dataclass, field
import fcntl
import io
import json
import os
import re
from pathlib import Path
import shlex
import shutil
import subprocess
import sys
import tempfile
import textwrap
from datetime import datetime, timezone
import time


VERBOSE = False
SESSION_CACHE = None
WAIT_ON_EXIT = False


def paint(text, tone="green"):
    colors = {"green": "#a7c080", "blue": "#7fbbb3", "yellow": "#dbbc7f",
              "red": "#e67e80", "dim": "#859289"}
    if not sys.stdout.isatty() or "NO_COLOR" in os.environ or os.environ.get("TERM") == "dumb":
        return text
    rgb = tuple(int(colors[tone][i:i + 2], 16) for i in (1, 3, 5))
    return f"\033[38;2;{rgb[0]};{rgb[1]};{rgb[2]}m{text}\033[0m"


def section(title):
    width = min(shutil.get_terminal_size((88, 24)).columns, 100)
    print("\n" + paint("── " + title + " " + "─" * max(0, width - len(title) - 4), "blue"), flush=True)


def clean(output):
    output = re.sub(r"\x1b\[[0-?]*[ -/]*[@-~]", "", output)
    return "".join(char for char in output if char in "\n\t" or char.isprintable())


def detail(output, tone=None):
    width = max(24, min(shutil.get_terminal_size((88, 24)).columns - 4, 96))
    for line in clean(output).splitlines():
        for part in textwrap.wrap(line, width=width, replace_whitespace=False) or [""]:
            print("  " + (paint(part, tone) if tone else part))


def package_rows(output):
    rows = []
    for line in clean(output).splitlines():
        match = re.fullmatch(r"(\S+)\s+(\S+)\s+->\s+(\S+)", line.strip())
        apt = re.match(r"Inst (\S+)(?: \[([^]]+)\])? \((\S+)", line)
        if match:
            rows.append(match.groups())
        elif apt:
            rows.append((apt[1], apt[2] or "new", apt[3]))
    return rows


NIX_REVISION_PATTERN = r"upgrading '([^']+)' from flake '([^']+)' to '([^']+)'"


def nix_revision_changes(output):
    return [(name, old, new) for name, old, new in re.findall(NIX_REVISION_PATTERN, clean(output))
            if old != new]


def show_check(output):
    upgrades = [name for name, old, new in nix_revision_changes(output)]
    if upgrades and not VERBOSE:
        detail(f"{len(upgrades)} Nix package source(s) have newer flake revisions.", "green")
        for name in upgrades:
            detail(name.rsplit(".", 1)[-1] + "  →  newer flake revision", "yellow")
        for line in clean(output).splitlines():
            if re.search(r"\b(warning|error)\b", line, re.I):
                detail(line, "yellow")
        detail("Use --verbose for flake URLs and revision details.", "dim")
        return
    if not upgrades and re.search(NIX_REVISION_PATTERN, clean(output)) and not VERBOSE:
        detail("No newer Nix flake revisions.", "green")
        for line in clean(output).splitlines():
            if re.search(r"\b(warning|error)\b", line, re.I):
                detail(line, "yellow")
        return
    rows = package_rows(output)
    if rows and not VERBOSE:
        print(paint(f"  {len(rows)} package{'s' if len(rows) != 1 else ''} available", "green"))
        width = max(30, min(shutil.get_terminal_size((88, 24)).columns - 6, 94))
        sizes = [width // 3, width // 3, width - 2 * (width // 3)]
        print(paint("  " + "  ".join(value.ljust(size) for value, size in zip(
            ("PACKAGE", "INSTALLED", "AVAILABLE"), sizes)), "dim"))
        for row in rows:
            columns = [textwrap.wrap(value, width=size) for value, size in zip(row, sizes)]
            for index in range(max(map(len, columns))):
                cells = [parts[index] if index < len(parts) else "" for parts in columns]
                print("  " + "  ".join(paint(cell.ljust(size), tone) for cell, size, tone in zip(
                    cells, sizes, ("green", "dim", "yellow"))))
        warnings = [line for line in clean(output).splitlines()
                    if re.search(r"\b(warning|error|held back)\b", line, re.I)]
        for line in warnings:
            detail(line, "yellow")
    else:
        detail(output.strip() or "Up to date — no changes reported.")


def confirm(prompt, default=False):
    try:
        choices = " [Y/n] " if default else " [y/N] "
        answer = input(paint("  " + prompt + choices, "yellow")).strip().lower()
        return default if not answer else answer in ("y", "yes")
    except EOFError:
        return False


@dataclass
class Source:
    name: str
    check: list
    upgrade: list
    refresh: list = field(default_factory=list)
    privileged: bool = False
    codes: tuple = (0,)
    note: str = ""


@dataclass
class CacheCleanup:
    name: str
    commands: list
    note: str
    privileged: bool = False
    previews: list = field(default_factory=list)
    kind: str = ""


def cache_jobs(manager, available):
    jobs = []
    if manager == "pacman":
        if shutil.which("paccache"):
            jobs.append(CacheCleanup("Arch package archives",
                [["paccache", "--nocolor", "-r", "-k", "3"],
                 ["paccache", "--nocolor", "-r", "-u", "-k", "0"]],
                "Keep the newest 3 cached versions; remove archives of uninstalled packages.", True,
                [["paccache", "--nocolor", "-d", "-k", "3"],
                 ["paccache", "--nocolor", "-d", "-u", "-k", "0"]], "paccache"))
        else:
            jobs.append(CacheCleanup("Arch package archives", [["pacman", "-Sc"]],
                "Remove uninstalled package archives and unused sync databases. Install pacman-contrib to keep 3 cached versions instead.", True))
    elif manager == "apt":
        jobs.append(CacheCleanup("APT package archives", [["apt-get", "autoclean"]],
            "Remove obsolete downloaded packages that are no longer available from repositories.", True,
            [["apt-get", "--simulate", "autoclean"]]))
    elif manager == "dnf":
        jobs.append(CacheCleanup("DNF package archives", [["dnf", "clean", "packages"]],
            "Remove downloaded package archives; keep repository metadata.", True))
    elif manager == "zypper":
        jobs.append(CacheCleanup("Zypper package archives", [["zypper", "clean"]],
            "Remove downloaded package archives; keep repository metadata.", True))
    elif manager == "xbps":
        jobs.append(CacheCleanup("XBPS package archives", [["xbps-remove", "-OO"]],
            "Remove outdated archives and cached packages that are no longer installed.", True,
            [["xbps-remove", "-n", "-OO"]]))
    elif manager == "apk":
        jobs.append(CacheCleanup("APK package archives", [["apk", "cache", "clean"]],
            "Remove obsolete or no-longer-needed archives from the configured APK cache.", True,
            [["apk", "--simulate", "cache", "clean"]]))
    for source in available:
        if source.name == "AUR":
            helper = source.check[0]
            jobs.append(CacheCleanup(f"AUR ({helper}) build cache", [[helper, "-Sc", "--aur"]],
                "Clean obsolete AUR build caches and sources; the helper keeps its own confirmation prompts."))
        elif source.name.startswith("Nix"):
            jobs.append(CacheCleanup("Nix unused store paths", [["nix-store", "--gc"]],
                "Collect unreachable store objects. Keep all profile generations and rollback roots.", False,
                [["nix-store", "--gc", "--print-dead"]], "nix"))
        elif source.name == "Flatpak":
            # Expand installed scopes later, isolating discovery failures from
            # the native/AUR/Nix cleanup jobs.
            jobs.append(CacheCleanup("Flatpak object store", [], "", kind="flatpak-discover"))
    return jobs


def flatpak_cache_jobs(timeout):
    result = run(["flatpak", "list", "--columns=installation:full"], capture=True, timeout=timeout)
    if result.returncode != 0:
        detail(result.stdout, "red")
        raise RuntimeError("Cannot discover Flatpak installations; skipping Flatpak cleanup.")
    scopes = {line.strip() for line in clean(result.stdout).splitlines() if line.strip()}
    # Empty installations can still contain an object cache.
    data = Path(os.environ.get("XDG_DATA_HOME", str(Path.home() / ".local/share")))
    if (data / "flatpak/repo").is_dir():
        scopes.add("user")
    if (Path(os.environ.get("FLATPAK_SYSTEM_DIR", "/var/lib/flatpak")) / "repo").is_dir():
        scopes.add("system")
    jobs = []
    for scope in sorted(scopes):
        if not re.fullmatch(r"[A-Za-z0-9_.-]+", scope):
            raise RuntimeError("Unrecognized Flatpak installation name; skipping Flatpak cleanup.")
        option = f"--{scope}" if scope in ("user", "system") else f"--installation={scope}"
        command = ["flatpak", "repair", option]
        jobs.append(CacheCleanup(f"Flatpak ({scope}) object store", [command],
            "Prune unused objects and verify this installation; damaged objects may be downloaded again. Installed apps and runtimes are retained.",
            scope != "user", [command + ["--dry-run"]]))
    return jobs


def cleanup_job(job, args):
    detail(job.name, "blue")
    detail(job.note, "dim")
    for command in job.commands + job.previews:
        if not shutil.which(command[0]):
            raise RuntimeError(f"Missing {command[0]}; skipping this cleanup.")
    outputs = []
    for command in job.previews:
        result = run(command, capture=True, timeout=args.timeout)
        if result.returncode != 0:
            detail(result.stdout, "red")
            raise RuntimeError("Cache preview failed; skipping this cleanup.")
        outputs.append(clean(result.stdout))
    if job.kind == "nix":
        store = os.environ.get("NIX_STORE_DIR", "/nix/store").rstrip("/") + "/"
        count = sum(line.startswith(store) for output in outputs for line in output.splitlines())
        detail(f"{count} unreachable store path(s).", "green" if count else "dim")
        if not count:
            return
    elif job.kind == "paccache":
        for label, output in zip(("Older versions", "Uninstalled packages"), outputs):
            detail(label + ": " + output.strip())
        if all("no candidate packages found" in output.lower() for output in outputs):
            return
    else:
        for output in outputs:
            detail(output.strip() or "No removable objects reported.")
    if VERBOSE and job.kind in ("nix", "paccache"):
        for output in outputs:
            detail(output)
    if not job.previews or VERBOSE or args.check:
        for command in job.commands:
            detail("Cleanup: " + shlex.join(command), "dim")
    if args.check:
        return
    if not confirm(f"Clean {job.name}?", default=True):
        detail("Skipped.", "dim")
        return
    for command in job.commands:
        if run(command, privileged=job.privileged).returncode != 0:
            raise RuntimeError("Cache cleanup failed; review the command's output.")
    detail("Cleanup complete.", "green")


def cleanup_caches(args, manager, available):
    section("Cached packages")
    failed = False
    selected = list(available)
    # An empty/missing user profile can still leave collectable store objects.
    if not args.no_nix and shutil.which("nix-store") and not any(source.name.startswith("Nix") for source in selected):
        selected.append(Source("Nix store", [], []))
    jobs = cache_jobs(manager, selected)
    if not jobs:
        detail("No supported caches selected.", "dim")
    for job in jobs:
        try:
            if job.kind == "flatpak-discover":
                flatpak_jobs = flatpak_cache_jobs(args.timeout)
                if not flatpak_jobs:
                    detail("Flatpak: no cached installations found.", "dim")
                for flatpak_job in flatpak_jobs:
                    try:
                        cleanup_job(flatpak_job, args)
                    except RuntimeError as error:
                        detail(f"{flatpak_job.name}: {error}", "red")
                        failed = True
            else:
                cleanup_job(job, args)
        except RuntimeError as error:
            detail(f"{job.name}: {error}", "red")
            failed = True
    return failed


def distro():
    try:
        lines = Path("/etc/os-release").read_text().splitlines()
    except OSError:
        return {}
    result = {}
    for line in lines:
        if "=" in line and not line.startswith("#"):
            key, value = line.split("=", 1)
            result[key] = value.strip().strip('\"\'')
    return result


def backend(info):
    if Path("/run/ostree-booted").exists() or info.get("VARIANT_ID") in (
        "silverblue", "kinoite", "sericea", "onyx", "coreos", "iot",
    ):
        return "none"
    ids = [info.get("ID", "")] + info.get("ID_LIKE", "").split()
    for name in ids:
        if name in ("arch", "cachyos", "manjaro", "endeavouros"):
            return "pacman"
        if name in ("debian", "ubuntu", "linuxmint", "pop"):
            return "apt"
        if name in ("fedora", "rhel", "centos", "rocky", "almalinux"):
            return "dnf"
        if name.startswith("opensuse") or name in ("suse", "sles"):
            return "zypper"
        if name == "void":
            return "xbps"
        if name == "alpine":
            return "apk"
    return "none"


def native_source(manager, info):
    cached = "Uses cached repository metadata; add --refresh for a fresh check."
    if manager == "pacman":
        # checkupdates uses a separate database; never pacman -Sy alone.
        return Source("System (Arch)", ["checkupdates", "--nocolor"],
                      ["pacman", "-Syu"], privileged=True, codes=(0, 2))
    if manager == "apt":
        return Source("System (APT)", ["apt-get", "--simulate", "upgrade"],
                      ["apt-get", "upgrade"], ["apt-get", "update"], True, note=cached)
    if manager == "dnf":
        return Source("System (DNF)", ["dnf", "check-update"],
                      ["dnf", "upgrade"], codes=(0, 100), privileged=True)
    if manager == "zypper":
        rolling = info.get("ID") in ("opensuse-tumbleweed", "opensuse-slowroll")
        return Source("System (Zypper)", ["zypper", "--no-refresh", "list-updates"],
                      ["zypper", "dup" if rolling else "update"],
                      ["zypper", "refresh"], True, (0, 100), cached)
    if manager == "xbps":
        return Source("System (Void)", ["xbps-install", "-Mun"],
                      ["xbps-install", "-Su"], privileged=True,
                      note="Void may require a second run after upgrading XBPS itself.")
    if manager == "apk":
        return Source("System (Alpine)", ["apk", "version", "-l", "<"],
                      ["apk", "upgrade"], ["apk", "update"], True, note=cached)
    return None


def nix_source(profile):
    # The manifest identifies the profile format; a failed modern command must
    # never silently fall back to nix-env against a different profile.
    profile = Path(profile).expanduser()
    if (profile / "manifest.json").exists():
        command = ["nix", "--extra-experimental-features", "nix-command flakes",
                   "profile", "upgrade", "--profile", str(profile), "--all"]
        return Source("Nix profile", command + ["--dry-run", "--refresh"], command + ["--refresh"],
                      note="Checks unlocked flake packages in this user profile (Nix 2.22+).")
    if (profile / "manifest.nix").exists():
        command = ["nix-env", "--profile", str(profile), "--upgrade"]
        return Source("Nix legacy profile", command + ["--dry-run"], command,
                      ["nix-channel", "--update"],
                      note="Uses this user's channels; --refresh updates them before checking.")
    return None


def sources(args, info):
    result = []
    manager = backend(info) if args.backend == "auto" else args.backend
    native = native_source(manager, info)
    if native:
        result.append(native)
    elif args.backend == "auto":
        print("No supported system backend detected; checking additional package managers.")
    if manager == "pacman" and not args.no_aur:
        helper = next((name for name in ("paru", "yay") if shutil.which(name)), None)
        if helper:
            result.append(Source("AUR", [helper, "-Qua"], [helper, "-Sua"]))
    if not args.no_flatpak and shutil.which("flatpak"):
        result.append(Source("Flatpak", ["flatpak", "remote-ls", "--updates"],
                             ["flatpak", "update"]))
    if not args.no_nix and (shutil.which("nix") or shutil.which("nix-env")):
        state = Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state")))
        default = Path.home() / ".nix-profile"
        if not default.exists():
            default = state / "nix/profiles/profile"
        source = nix_source(args.nix_profile or default)
        if source:
            result.append(source)
        else:
            print(f"Nix: no supported user profile at {args.nix_profile or default}.")
        if VERBOSE:
            detail("NixOS/Home Manager configurations and the Nix daemon are managed separately.", "dim")
    return result


def run(command, privileged=False, capture=False, timeout=None):
    if not shutil.which(command[0]):
        raise RuntimeError(f"Missing {command[0]}; install it to use this update source.")
    if privileged and os.geteuid() != 0:
        wrapper = next((name for name in ("sudo", "doas") if shutil.which(name)), None)
        if not wrapper:
            raise RuntimeError("System updates require sudo or doas.")
        command = [wrapper] + command
    if VERBOSE:
        detail("$ " + shlex.join(command), "dim")
    env = dict(os.environ, LC_ALL="C")
    try:
        return subprocess.run(command, env=env, text=True, timeout=timeout,
                              stdin=subprocess.DEVNULL if capture and not privileged else None,
                              stdout=subprocess.PIPE if capture else None,
                              stderr=subprocess.STDOUT if capture else None)
    except subprocess.TimeoutExpired as error:
        raise RuntimeError(f"Check timed out after {timeout}s.") from error
    except OSError as error:
        raise RuntimeError(str(error)) from error


def check_succeeded(source, checked):
    if checked.returncode in source.codes:
        return True
    # AUR query helpers use exit 1 for an empty update list. Diagnostic
    # output still means failure, including network and state-file errors.
    return (source.check[0] in ("paru", "yay") and checked.returncode == 1
            and not clean(checked.stdout).strip())


def process(source, args):
    section(source.name)
    if source.note and (VERBOSE or source.refresh):
        detail(source.note, "dim")
    if args.refresh and source.refresh:
        # Refresh may require a password. It never upgrades installed packages.
        if run(source.refresh, source.privileged).returncode != 0:
            raise RuntimeError("Metadata refresh failed; skipping this source.")
    print(paint("  Checking for updates…", "dim"), flush=True)
    checked = run(source.check, capture=True, timeout=args.timeout)
    if not check_succeeded(source, checked):
        detail(checked.stdout, "red")
        raise RuntimeError(f"Check failed (exit {checked.returncode}); skipping this source.")
    show_check(checked.stdout)
    if args.check:
        return
    if source.check[0] == "nix" and parsed_updates(source, checked.stdout, checked.returncode) == []:
        return
    # Native dry runs contain status text as well as packages. Let the package
    # manager resolve the final transaction rather than guessing from that text.
    if not checked.stdout.strip() and checked.returncode != 100:
        return
    if VERBOSE:
        detail("Upgrade command: " + shlex.join(source.upgrade), "dim")
    if not confirm(f"Install {source.name} updates?", default=True):
        detail("Skipped.", "dim")
        return
    if run(source.upgrade, source.privileged).returncode != 0:
        raise RuntimeError("Upgrade failed; review the package manager's output.")
    detail("Update finished.", "green")


def parsed_updates(source, output, exit_code):
    """Return packages, or None when successful output cannot be counted."""
    output = clean(output)
    program = source.check[0]
    rows = package_rows(output)
    packages = [{"name": name, "installed": old, "available": new, "kind": "package"}
                for name, old, new in rows]
    if packages:
        return packages
    if program in ("checkupdates", "paru", "yay"):
        return [] if not output.strip() else None
    if program == "apt-get":
        return [] if re.search(r"^0 upgraded,", output, re.M) else None
    if program == "dnf":
        if exit_code == 0:
            return []
        for line in output.splitlines():
            match = re.fullmatch(r"(\S+\.\S+)\s+(\S+)\s+(\S+)", line.strip())
            if match:
                packages.append({"name": match[1], "installed": None, "available": match[2], "kind": "package"})
    elif program == "zypper":
        for line in output.splitlines():
            fields = [field.strip() for field in line.split("|")]
            if len(fields) >= 5 and fields[0] in ("v", "v?", "i", "i+"):
                packages.append({"name": fields[2], "installed": fields[3] if len(fields) >= 6 else None,
                                 "available": fields[4] if len(fields) >= 6 else fields[3], "kind": "package"})
        if not packages and "No updates found" in output:
            return []
    elif program == "xbps-install":
        for line in output.splitlines():
            fields = line.split()
            if len(fields) == 6 and fields[1] in ("update", "install"):
                name, _, version = fields[0].rpartition("-")
                packages.append({"name": name or fields[0], "installed": None, "available": version, "kind": "package"})
        if not output.strip():
            return []
    elif program == "apk":
        for line in output.splitlines():
            match = re.fullmatch(r"(\S+)\s+<\s+(\S+)", line.strip())
            if match:
                installed = re.fullmatch(r"(.+)-([0-9][^-]*(?:-r\d+)?)", match[1])
                if installed:
                    packages.append({"name": installed[1], "installed": installed[2], "available": match[2], "kind": "package"})
        if not output.strip() or "Installed" in output and "Available" in output and len(output.splitlines()) <= 1:
            return []
    elif program == "flatpak":
        for line in output.splitlines():
            fields = line.split("\t")
            if len(fields) == 4 and fields[0].strip():
                packages.append({"name": fields[0].strip(), "installed": None,
                                 "available": fields[1].strip() or None, "kind": "package",
                                 "branch": fields[2].strip(), "arch": fields[3].strip()})
        if not output.strip():
            return []
    elif program == "nix":
        for name, old, new in nix_revision_changes(output):
            packages.append({"name": name.rsplit(".", 1)[-1], "installed": None,
                             "available": None, "kind": "flake"})
        remaining = re.sub(NIX_REVISION_PATTERN, "", output)
        if not packages and (not remaining.strip() or all(
                line.strip().startswith(("warning:", "unpacking ", "copying path "))
                for line in remaining.splitlines() if line.strip())):
            return []
    elif program == "nix-env":
        for old, new in re.findall(r"upgrading '([^']+)' to '([^']+)'", output):
            name, _, version = old.rpartition("-")
            packages.append({"name": name, "installed": version,
                             "available": new.rpartition("-")[2], "kind": "package"})
        if not output.strip():
            return []
    unique = {}
    for package in packages:
        key = (package["name"], package.get("branch"), package.get("arch"))
        unique[key] = package
    return list(unique.values()) if unique else None


def json_report(args, available):
    result = {"version": 1, "checked_at": datetime.now(timezone.utc).isoformat(),
              "status": "unknown", "total": 0, "sources": [], "notes": [], "busy": False,
              "reboot": {"required": False, "reasons": []}}
    for source in available:
        cached = source.check[0] in ("apt-get", "zypper", "apk", "nix-env")
        item = {"name": source.name, "status": "error", "count": None,
                "packages": [], "cached": cached, "message": "", "warnings": []}
        command = source.check
        if command[0] == "flatpak":
            command = ["flatpak", "remote-ls", "--updates", "--columns=application,version,branch,arch"]
        try:
            checked = run(command, capture=True, timeout=args.timeout)
            output = clean(checked.stdout)
            if not check_succeeded(source, checked):
                raise RuntimeError(output.strip()[:2000] or f"Check failed (exit {checked.returncode}).")
            item["warnings"] = [line.strip()[:500] for line in output.splitlines()
                                if re.search(r"\b(warning|held back|kept back)\b", line, re.I)][:10]
            packages = parsed_updates(source, output, checked.returncode)
            if packages is None:
                item["status"] = "unknown"
                item["message"] = "Could not count this check's output. Open the updater for details."
            else:
                item["packages"] = packages
                item["count"] = len(packages)
                item["status"] = "updates" if packages else "up-to-date"
                result["total"] += len(packages)
                if any(package["kind"] == "flake" for package in packages):
                    item["message"] = "Nix reports newer flake revisions; package versions may be unchanged."
        except RuntimeError as error:
            item["message"] = str(error)
        result["sources"].append(item)
    reasons = reboot_reasons()
    result["reboot"] = {"required": bool(reasons), "reasons": reasons}
    statuses = [source["status"] for source in result["sources"]]
    result["status"] = "error" if "error" in statuses else "updates" if result["total"] else \
        "unknown" if "unknown" in statuses or not statuses else "up-to-date"
    result["checked_at"] = datetime.now(timezone.utc).isoformat()
    return result


def check_json(args):
    """Background mode: no sudo, installs, refresh commands, cleanup or services."""
    cache = Path(os.environ.get("XDG_CACHE_HOME", str(Path.home() / ".cache"))) / "mori-update"
    with contextlib.redirect_stdout(io.StringIO()) as notes:
        cache.mkdir(parents=True, exist_ok=True, mode=0o700)
        with (cache / "lock").open("w") as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                result = {"version": 1, "busy": True, "status": "busy", "sources": [],
                          "total": 0, "notes": ["An update or check is already running."]}
            else:
                available = sources(args, distro())
                discovery_notes = notes.getvalue().strip().splitlines()
                with tempfile.TemporaryDirectory(prefix="mori-update-") as database:
                    previous = os.environ.get("CHECKUPDATES_DB")
                    os.environ["CHECKUPDATES_DB"] = database
                    try:
                        result = json_report(args, available)
                    finally:
                        if previous is None:
                            os.environ.pop("CHECKUPDATES_DB", None)
                        else:
                            os.environ["CHECKUPDATES_DB"] = previous
                result["notes"] = discovery_notes
                # Atomic replacement lets the widget restore the last check on reload.
                with tempfile.NamedTemporaryFile(mode="w", dir=cache, delete=False) as state:
                    json.dump(result, state)
                    path = state.name
                os.replace(path, cache / "status.json")
    print(json.dumps(result))
    return int(result["status"] == "error")


def launch_updater():
    terminal = shutil.which("foot")
    if not terminal:
        raise RuntimeError("Foot is not installed or is missing from PATH.")
    # Detach the terminal so moving/disabling/reloading the widget cannot kill
    # an in-progress package transaction.
    subprocess.Popen([terminal, "--title", "Mori updates", str(Path(__file__).resolve()), "--refresh", "--wait"],
                     start_new_session=True, stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return 0


SESSION_SERVICES = {name + ".service" for name in (
    "display-manager", "gdm", "plasmalogin", "sddm", "lightdm", "lxdm", "slim",
    "xdm", "greetd", "nodm", "ly", "lemurs", "systemd-logind", "elogind",
    "dbus", "dbus-broker",
)}


def systemd_running():
    return Path("/run/systemd/system").is_dir() and bool(shutil.which("systemctl"))


def reboot_reasons():
    reasons = []
    if Path("/.dockerenv").exists() or Path("/run/.containerenv").exists() or os.environ.get("container"):
        return reasons
    if any(Path(path).exists() for path in ("/run/reboot-required", "/var/run/reboot-required")):
        reasons.append("The system has marked a reboot as required.")
    release = os.uname().release
    modules = Path("/usr/lib/modules")
    # Missing modules only mean something if this machine has installed kernels.
    if modules.is_dir() and any(modules.iterdir()) and not (modules / release).is_dir():
        reasons.append(f"The running kernel ({release}) no longer has installed modules.")
    elif modules.is_dir() and any(modules.glob("*/vmlinuz")) and not (modules / release / "vmlinuz").exists():
        reasons.append(f"The running kernel ({release}) has been replaced on disk.")
    return reasons


def runit_service_for_pid(pid, executable, proc_root=Path("/proc"),
                          service_root=Path("/var/service")):
    """Only trust an enabled runsv ancestor of the process xcheckrestart found."""
    try:
        if os.readlink(proc_root / str(pid) / "exe") != executable:
            return None  # The PID exited and may have been reused since the scan.
    except OSError:
        return None
    seen = set()
    while pid > 1 and pid not in seen:
        seen.add(pid)
        process = proc_root / str(pid)
        try:
            stat = (process / "stat").read_text()
            # The comm field is parenthesized and may contain spaces or ')'.
            end_of_comm = stat.rfind(") ")
            if end_of_comm < 0:
                return None
            parent = int(stat[end_of_comm + 2:].split()[1])
        except (OSError, ValueError, IndexError):
            return None
        if parent <= 1:
            return None
        supervisor = proc_root / str(parent)
        try:
            args = (supervisor / "cmdline").read_bytes().split(b"\0")
            supervisor_exe = Path(os.readlink(supervisor / "exe")).name
        except OSError:
            return None
        if supervisor_exe == "runsv" and len(args) > 1:
            argument = os.fsdecode(args[1])
            name = Path(argument).name
            if (re.fullmatch(r"[A-Za-z0-9_@.:-]+", name)
                    and not name.startswith("-")
                    and (argument == name or Path(argument).resolve() ==
                         (service_root / name).resolve())
                    and (service_root / name).is_dir()):
                return name
            return None
        pid = parent
    return None


def xcheckrestart_services(output):
    units = set()
    other = 0
    for line in output.splitlines():
        match = re.fullmatch(r"([1-9][0-9]*) (.+) \([^()]*\)", line)
        if not match:
            continue
        unit = runit_service_for_pid(int(match[1]), match[2])
        if unit:
            units.add(unit)
        else:
            other += 1
    if other:
        detail(f"{other} outdated process(es) are not linked to enabled runit services; "
               "restart those applications or log out as appropriate.", "yellow")
    return sorted(units)


def restart_scan(timeout):
    """Read-only probes. Never run a tool's default automatic restart mode."""
    if shutil.which("needrestart"):
        command = ["needrestart", "-b", "-r", "l"]
        kind = "needrestart"
    elif systemd_running() and shutil.which("checkservices"):
        command = ["checkservices", "-L", "-F", "-P", "-R"]
        kind = "checkservices"
    elif systemd_running() and shutil.which("needs-restarting"):
        command = ["needs-restarting", "-s"]
        kind = "dnf"
    elif not systemd_running() and shutil.which("sv") and shutil.which("xcheckrestart"):
        command = ["xcheckrestart"]
        kind = "xcheckrestart"
    else:
        return None, []
    detail("Scanning services (may ask for your password)…", "dim")
    result = run(command, privileged=True, capture=True, timeout=timeout)
    if result.returncode != 0:
        detail(result.stdout, "red")
        raise RuntimeError("Service scan failed; restart status is unknown.")
    output = clean(result.stdout)
    if VERBOSE:
        detail(output)
    if kind == "checkservices" and re.search(r"\bError::", output):
        detail(output, "red")
        raise RuntimeError("Service scan reported errors; restart status is incomplete.")
    reasons = []
    if kind == "needrestart":
        units = re.findall(r"^NEEDRESTART-SVC:\s*(\S+)\s*$", output, re.M)
        if re.search(r"^NEEDRESTART-KSTA:\s*[23]\s*$", output, re.M):
            reasons.append("A kernel upgrade is pending (needrestart).")
        if re.search(r"^NEEDRESTART-UCSTA:\s*2\s*$", output, re.M):
            reasons.append("A CPU microcode upgrade is pending (needrestart).")
    elif kind == "checkservices":
        units = re.findall(r"^'([^']+\.service)'\s*$", output, re.M)
    elif kind == "xcheckrestart":
        units = xcheckrestart_services(output)
    else:
        units = re.findall(r"^([\w@.\\:-]+\.service)\s*$", output, re.M)
    # Validate names before giving them to an init tool. Do not include the
    # display/login/session infrastructure in the restart selection.
    units = sorted({unit for unit in units if re.fullmatch(r"[A-Za-z0-9_@.\\:-]+", unit)
                    and not unit.startswith("-")})
    excluded = [unit for unit in units if unit.removesuffix(".service") + ".service"
                in SESSION_SERVICES or unit.startswith("user@")]
    if excluded:
        detail("Session services need a logout/reboot: " + ", ".join(excluded), "yellow")
    return [unit for unit in units if unit not in excluded], reasons


def service_command(unit):
    if systemd_running():
        return ["systemctl", "restart", unit]
    if shutil.which("rc-service"):
        return ["rc-service", unit, "restart"]
    if shutil.which("sv"):
        for directory in ("/var/service", "/run/runit/service"):
            path = Path(directory) / unit
            if path.exists():
                return ["sv", "restart", str(path)]
    if shutil.which("service"):
        return ["service", unit, "restart"]
    return None


def select_services(units):
    for index, unit in enumerate(units, 1):
        print("  " + paint(f"{index:>2}", "yellow") + "  " + unit)
    while True:
        try:
            answer = input(paint("  Restart services: numbers, 0/all for all, or Enter to skip: ", "yellow")).strip()
        except EOFError:
            return []
        if not answer:
            return []
        if answer.lower() in ("0", "all"):
            return units
        parts = answer.split()
        if all(part.isdecimal() and 1 <= int(part) <= len(units) for part in parts):
            return list(dict.fromkeys(units[int(part) - 1] for part in parts))
        detail("Choose the displayed numbers, 0/all, or Enter.", "yellow")


def maintenance(args, scan_services=True):
    section("After updates")
    reasons = reboot_reasons()
    failed = False
    if scan_services:
        try:
            units, extra = restart_scan(args.timeout)
            reasons.extend(extra)
            if units is None:
                detail("Service check unavailable — install needrestart, checkservices on Arch, "
                       "or xtools-minimal on Void.", "dim")
            elif not units:
                detail("No services needing a restart were reported.", "green")
            else:
                detail(f"{len(units)} service(s) need restarting.", "yellow")
                selected = [] if args.check else select_services(units)
                if args.check:
                    for unit in units:
                        detail(unit)
                if selected and systemd_running():
                    if run(["systemctl", "daemon-reload"], privileged=True).returncode != 0:
                        raise RuntimeError("Could not reload service definitions; no services restarted.")
                for unit in selected:
                    command = service_command(unit)
                    if not command:
                        detail(f"No supported restart command for {unit}.", "yellow")
                        failed = True
                    elif run(command, privileged=True).returncode != 0:
                        detail(f"Failed to restart {unit}.", "red")
                        failed = True
                    else:
                        detail(f"Restarted {unit}.", "green")
        except RuntimeError as error:
            detail(str(error), "red")
            failed = True
    if reasons:
        detail("Reboot recommended", "yellow")
        for reason in dict.fromkeys(reasons):
            detail(reason)
        if not args.check and confirm("Reboot now? Save your work first."):
            command = ["systemctl", "reboot"] if systemd_running() else ["reboot"]
            if run(command, privileged=not systemd_running()).returncode != 0:
                raise RuntimeError("Reboot failed.")
    elif failed:
        detail("No reboot marker found; the additional restart scan failed.", "yellow")
    else:
        detail("No reboot requirement detected by the available checks.", "green")
    return failed


def main():
    global VERBOSE, SESSION_CACHE, WAIT_ON_EXIT
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", "--list", action="store_true", help="check only; never install packages")
    parser.add_argument("--refresh", action="store_true", help="refresh cached metadata/channels (may need sudo)")
    parser.add_argument("--backend", choices=("auto", "none", "pacman", "apt", "dnf", "zypper", "xbps", "apk"), default="auto")
    parser.add_argument("--nix-profile", help="Nix user profile to check/upgrade")
    parser.add_argument("--no-nix", action="store_true")
    parser.add_argument("--no-aur", action="store_true")
    parser.add_argument("--no-flatpak", action="store_true")
    parser.add_argument("--timeout", type=int, default=180, help="seconds per check (default: 180)")
    parser.add_argument("--verbose", action="store_true", help="show commands and full check output")
    parser.add_argument("--maintenance", action="store_true", help="only check reboot/services; ask before restarting")
    parser.add_argument("--no-maintenance", action="store_true", help="skip reboot/service checks")
    parser.add_argument("--clean", action="store_true", help="only offer cache cleanup; combine with --check to preview")
    parser.add_argument("--no-cleanup", action="store_true", help="skip the cached-package cleanup step")
    parser.add_argument("--json", action="store_true", help="read-only background check as JSON; no prompts or cleanup")
    parser.add_argument("--launch", action="store_true", help="open the interactive updater in a detached Foot window")
    parser.add_argument("--wait", action="store_true", help="wait for Enter before closing the terminal")
    args = parser.parse_args()
    WAIT_ON_EXIT = args.wait and not args.json and not args.launch
    VERBOSE = args.verbose
    if args.maintenance and args.no_maintenance:
        parser.error("--maintenance and --no-maintenance cannot be combined")
    if args.clean and (args.no_cleanup or args.maintenance):
        parser.error("--clean cannot be combined with --no-cleanup or --maintenance")
    if args.json and (args.refresh or args.clean or args.maintenance or args.launch):
        parser.error("--json cannot be combined with refresh, cleanup, maintenance or launch")
    if args.timeout <= 0:
        parser.error("--timeout must be positive")
    if args.launch:
        return launch_updater()
    if args.json:
        VERBOSE = False
        return check_json(args)
    if not args.check and not sys.stdin.isatty():
        parser.error("interactive updates require a terminal; use --check")
    if os.geteuid() == 0:
        parser.error("run as your normal user; system commands use sudo/doas when needed")
    # Private user-owned directory avoids predictable /tmp lockfile symlinks.
    cache = Path(os.environ.get("XDG_CACHE_HOME", str(Path.home() / ".cache"))) / "mori-update"
    cache.mkdir(parents=True, exist_ok=True, mode=0o700)
    with (cache / "lock").open("w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print("mori-update is already running.", file=sys.stderr)
            return 1
        if not args.check:
            SESSION_CACHE = cache
        section("Mori · updates")
        detail("Check only" if args.check else "Review updates · choose what to install", "dim")
        if args.maintenance:
            return int(maintenance(args))
        info = distro()
        manager = backend(info) if args.backend == "auto" else args.backend
        available = sources(args, info)
        if args.clean:
            return int(cleanup_caches(args, manager, available))
        if not available:
            print("No supported package sources found.", file=sys.stderr)
            return 1
        failed = False
        # checkupdates uses a private temporary database, removed even on failure.
        with tempfile.TemporaryDirectory(prefix="mori-update-") as database:
            os.environ["CHECKUPDATES_DB"] = database
            for source in available:
                try:
                    process(source, args)
                except RuntimeError as error:
                    detail(f"{source.name}: {error}", "red")
                    failed = True
        if not args.no_cleanup:
            failed = cleanup_caches(args, manager, available) or failed
        if not args.no_maintenance and any(source.privileged for source in available):
            try:
                failed = maintenance(args, scan_services=not args.check) or failed
            except RuntimeError as error:
                detail(str(error), "red")
                failed = True
        section("Finished")
        detail("Some checks or actions failed — review the messages above." if failed else
               "Checks complete." if args.check else "Update session complete.", "yellow" if failed else "green")
        return int(failed)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print("\nCancelled.", file=sys.stderr)
        sys.exit(130)
    except RuntimeError as error:
        print(f"mori-update: {error}", file=sys.stderr)
        sys.exit(1)
    finally:
        if SESSION_CACHE is not None:
            try:
                (SESSION_CACHE / "last-session").write_text(str(time.time_ns()))
            except OSError:
                pass
        if WAIT_ON_EXIT and sys.stdin.isatty():
            try:
                input(paint("\n  Press Enter to close… ", "yellow"))
            except (EOFError, KeyboardInterrupt):
                pass
