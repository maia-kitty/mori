{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/mori-cachyos.txt",
    "color": {
      "1": "green",
      "2": "bright_green"
    }
  },
  "display": {
    "key": { "width": 9 },
    "color": {
      "keys": "38;2;211;198;170",
      "output": "38;2;133;146;137"
    }
  },
  "modules": [
    { "type": "os", "key": "os"},
    { "type": "kernel", "key": "kernel"},
    { "type": "uptime", "key": "uptime"},
    { "type": "shell", "key": "shell"},
    { "type": "wm", "key": "wm"},
    { "type": "terminal", "key": "term"}
  ]
}
