[Desktop Entry]
# Mori override: the packaged "kew play %F" exits with "Music not found" when launched without files.
# MimeType dropped with %F, so kew is not offered as a handler for files or folders.
Name=kew
GenericName=Music Player
Comment=Music for the Shell
Exec=kew
Icon=kew
Terminal=true
Type=Application
Categories=Audio;Music;Player;AudioVideo;ConsoleOnly;
Keywords=music;audio;player;terminal;tui;winamp;radio;podcast;
StartupNotify=false
