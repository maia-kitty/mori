binds {
    // === System & Overview ===
    Mod+Tab repeat=false { toggle-overview; }

    // === Application Launchers ===
    Mod+T hotkey-overlay-title="Open Terminal" { spawn "kitty"; }
    Mod+Space hotkey-overlay-title="Application Launcher" { spawn "fuzzel"; }
    Mod+Z hotkey-overlay-title="Open Zen Browser" { spawn "zen-browser"; }

    Mod+V hotkey-overlay-title="Clipboard Manager" {
        spawn "mori-clipboard";
    }
    Mod+M hotkey-overlay-title="Task Manager" {
        spawn "mori-btop";
    }

    Mod+X hotkey-overlay-title="Power Menu: Toggle" { spawn "qs" "-c" "mori" "ipc" "call" "bar" "togglePowerMenu"; }
    Mod+Y hotkey-overlay-title="Browse Wallpapers" {
        spawn "qs" "-c" "mori" "ipc" "call" "bar" "toggleWallpaperPicker";
    }
    Mod+N hotkey-overlay-title="Notification Center" { spawn "qs" "-c" "mori" "ipc" "call" "bar" "toggleNotifications"; }
    Mod+Shift+N hotkey-overlay-title="Notepad" { spawn "obsidian"; }

    // === Security ===
    Mod+Alt+L hotkey-overlay-title="Lock Screen" {
        spawn "swaylock";
    }
    Mod+Shift+E { quit; }

    // === Audio Controls ===
    Mod+F4 allow-when-locked=true {
        spawn "qs" "-c" "mori" "ipc" "call" "bar" "volumeUp";
    }
    Mod+F2 allow-when-locked=true {
        spawn "qs" "-c" "mori" "ipc" "call" "bar" "volumeDown";
    }
    Mod+F3 allow-when-locked=true {
        spawn "qs" "-c" "mori" "ipc" "call" "bar" "toggleMute";
    }
    
    // === Window Management ===
    Mod+Q repeat=false { close-window; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Shift+T { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    // === Focus (arrows / wheel / mouse buttons ) ===
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Down  { focus-workspace-down; }
    Mod+Up    { focus-workspace-up; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }
    Mod+MouseForward { focus-column-left; }
    Mod+MouseBack { focus-column-right; }
    Mod+semicolon { focus-monitor-next; }

    // === Move columns/windows (Ctrl+arrows / Ctrl+wheel ) ===
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Down  { move-column-to-workspace-down; }
    Mod+Ctrl+Up    { move-column-to-workspace-up; }
    Mod+Ctrl+MouseBack { move-column-right; }
    Mod+Ctrl+MouseForward  { move-column-left; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    // === Column Jump (first/last) ===
    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    // === Move to Monitor ===
    Mod+Shift+Left  { move-column-to-monitor-left; }
    Mod+Shift+Right { move-column-to-monitor-right; }
    Mod+Shift+Down  { move-column-to-monitor-down; }
    Mod+Shift+Up    { move-column-to-monitor-up; }
    Mod+Shift+MouseForward  { move-column-to-monitor-left; }
    Mod+Shift+MouseBack { move-column-to-monitor-right; }
    Mod+Shift+WheelScrollDown  { move-column-to-monitor-down; }
    Mod+Shift+WheelScrollUp    { move-column-to-monitor-up; }
    
    // === Column Management ===
    Mod+J  { consume-or-expel-window-left; }
    Mod+L { consume-or-expel-window-right; }
    Mod+K { focus-window-down; }
    Mod+I { focus-window-up; }
    Mod+Ctrl+K { move-window-down; }
    Mod+Ctrl+I { move-window-up; }
    
    // === Sizing & Layout ===
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+C { center-column; }
    Mod+Ctrl+C { center-visible-columns; }

    // === Screenshots ===
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Mod+Shift+S hotkey-overlay-title="Screenshot: Area" { screenshot; }
    Alt+Print { screenshot-window; }

    // === System Controls ===
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+P { power-off-monitors; }

}
    // === Recent Windows ===
recent-windows {
    binds {
        Alt+Tab         { next-window scope="output"; }
        Alt+Shift+Tab   { previous-window scope="output"; }
        Alt+grave       { next-window filter="app-id"; }
        Alt+Shift+grave { previous-window filter="app-id"; }
    }
}
