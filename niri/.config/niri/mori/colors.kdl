// Mori Everforest palette, shared with the Quickshell theme.

layout {
    background-color "transparent"

    focus-ring {
        active-color   "#d3c6aa"
        inactive-color "#859289"
        urgent-color   "#e67e80"
    }

    border {
        active-color   "#d3c6aa"
        inactive-color "#859289"
        urgent-color   "#e67e80"
    }

    shadow {
        color "#232a2eb3"
    }

    tab-indicator {
        active-color   "#d3c6aa"
        inactive-color "#859289"
        urgent-color   "#e67e80"
    }

    insert-hint {
        color "#a7c08080"
    }
}

recent-windows {
    highlight {
        active-color   "#3d484d"
        urgent-color   "#e67e80"
    }
}
