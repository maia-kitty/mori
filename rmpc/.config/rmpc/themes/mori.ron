#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]

// Everforest Dark, shared with the Mori Quickshell theme.
(
    format_tag_separator: " | ",
    background_color: "rgb(39, 46, 51)",
    text_color: "rgb(211, 198, 170)",
    header_background_color: "rgb(46, 56, 60)",
    modal_background_color: "rgb(55, 65, 69)",
    modal_backdrop: true,

    preview_label_style: (fg: "rgb(131, 192, 146)"),
    preview_metadata_group_style: (fg: "rgb(167, 192, 128)", modifiers: "Bold"),
    highlighted_item_style: (fg: "rgb(39, 46, 51)", bg: "rgb(167, 192, 128)", modifiers: "Bold"),
    current_item_style: (fg: "rgb(167, 192, 128)", modifiers: "Bold"),
    borders_style: (fg: "rgb(122, 132, 120)"),
    highlight_border_style: (fg: "rgb(167, 192, 128)"),

    symbols: (
        song: "",
        dir: "",
        playlist: "󰲸",
        marker: "",
        ellipsis: "…",
        song_style: (fg: "rgb(127, 187, 179)"),
        dir_style: (fg: "rgb(219, 188, 127)"),
        playlist_style: (fg: "rgb(214, 153, 182)"),
    ),

    level_styles: (
        info: (fg: "rgb(127, 187, 179)", bg: "rgb(39, 46, 51)"),
        warn: (fg: "rgb(219, 188, 127)", bg: "rgb(39, 46, 51)"),
        error: (fg: "rgb(230, 126, 128)", bg: "rgb(39, 46, 51)"),
        debug: (fg: "rgb(131, 192, 146)", bg: "rgb(39, 46, 51)"),
        trace: (fg: "rgb(214, 153, 182)", bg: "rgb(39, 46, 51)"),
    ),

    progress_bar: (
        symbols: ["━", "━", "━", " ", "●"],
        track_style: (fg: "rgb(65, 75, 80)"),
        elapsed_style: (fg: "rgb(167, 192, 128)"),
        thumb_style: (fg: "rgb(219, 188, 127)"),
        use_track_when_empty: true,
    ),
    scrollbar: (
        symbols: ["│", "█", "▲", "▼"],
        track_style: (fg: "rgb(65, 75, 80)"),
        ends_style: (fg: "rgb(122, 132, 120)"),
        thumb_style: (fg: "rgb(131, 192, 146)"),
    ),
    tab_bar: (
        active_style: (fg: "rgb(39, 46, 51)", bg: "rgb(167, 192, 128)", modifiers: "Bold"),
        inactive_style: (fg: "rgb(157, 169, 160)"),
    ),
    lyrics: (timestamp: false),
)
